# ─────────────────────────────────────────────────────────────
# Keeply HQ — variables d'environnement
# Copie ce fichier en .env.local (en local) ou ajoute-les dans
# Vercel > Settings > Environment Variables (en ligne).
# ─────────────────────────────────────────────────────────────

# Obligatoire en ligne : ton mot de passe pour entrer dans le tableau de bord
ADMIN_PASSWORD=
# Obligatoire en ligne : une longue phrase aléatoire (signe la session et chiffre tes clés d'API)
# Générer : openssl rand -base64 32
SESSION_SECRET=

# Tâche planifiée (publication des posts, réponses auto, test quotidien, prospection)
CRON_SECRET=
# Jeton pour les envois automatiques (webhook de ventes, rapport des tests GitHub)
INGEST_TOKEN=

# Fuseau horaire des automatisations
HQ_TIMEZONE=Europe/Paris

# Stockage en ligne (obligatoire sur Vercel, le disque n'y est pas permanent)
# Vercel > Storage > Upstash Redis : ces variables sont ajoutées automatiquement.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Facultatif : toutes les clés ci-dessous peuvent aussi être saisies
#    dans la page Connexions (elles y sont chiffrées). Une variable
#    définie ici prend le dessus sur la valeur saisie dans l'app.

# Claude (IA)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# App Store Connect
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_PRIVATE_KEY=
APPSTORE_VENDOR_NUMBER=
APPSTORE_APP_ID=

# Google Play
GOOGLEPLAY_SERVICE_ACCOUNT=
GOOGLEPLAY_BUCKET=
GOOGLEPLAY_PACKAGE=

# Stripe / RevenueCat
STRIPE_SECRET_KEY=
REVENUECAT_SECRET_KEY=
REVENUECAT_PROJECT_ID=

# Instagram / Meta Ads
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
BLOB_READ_WRITE_TOKEN=

# Boîte mail pro (IMAP / SMTP)
MAIL_IMAP_HOST=
MAIL_SMTP_HOST=
MAIL_USER=
MAIL_PASSWORD=

# Prospection
OUTREACH_SMTP_HOST=
OUTREACH_USER=
OUTREACH_PASSWORD=
GOOGLE_PLACES_API_KEY=

# Santé de l'app
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
